# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR Y SEGURIDAD
# ==============================================================================
JWT_SECRET_KEY=tu_clave_secreta_super_segura_para_firmar_tokens_jwt
FRONTEND_URL=https://tu-frontend-desplegado.com

# Feature Flag para habilitar/deshabilitar el registro de usuarios en caliente
# Valores aceptados como True: "true", "1", "yes", "y". Cualquier otro valor será False.
ENABLE_REGISTER=false

# ==============================================================================
# NOTIFICACIONES POR CORREO (SMTP GMAIL)
# ==============================================================================
GMAIL_ADDRESS=tu-correo-emisor@gmail.com
GMAIL_PASSWORD=tu-contrasenya-de-aplicacion-de-gmail
BOSS_EMAIL_ADDRESS=correo-del-jefe@empresa.com

# Feature Flag para habilitar el envío real de correos electrónicos
# Si es "false", el backend omitirá el envío real facilitando el desarrollo local.
SEND_REAL_EMAILS=false

# ==============================================================================
# PERSISTENCIA Y BASES DE DATOS (Soporte Dual)
# ==============================================================================

# Producción: URI / String de conexión de PostgreSQL en Supabase
SUPABASE_PG_CONN=postgresql://postgres:tu_password@db.supabase.co:5432/postgres
PG_SCHEMA=public

# Local: Ruta del archivo SQLite para entorno de desarrollo rápido (opcional)
# Si se provee una ruta (ej. local.db), el sistema levantará SQLite con autogeneración de tablas.
SQLITE_PATH=local_database.db